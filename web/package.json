    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "overridesComment": "Several @solana/wallet-adapter-* packages depend on @types/react 19 while this app is on React 18. Two copies in the tree make React 18's JSX types incompatible with 19's (ReactNode gained Promise<ReactNode>), surfacing as 'ConnectionProvider cannot be used as a JSX component'. Pin one version tree-wide. Note npm rejects a '//' comment key inside overrides itself, hence this sibling field.",
  "overrides": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0"
  }
