  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "verify:operator": "ts-node --project scripts/tsconfig.json scripts/verify-operator-flow.ts",
    "sync-idl": "cp ../routerpulse/target/idl/routerpulse.json src/lib/idl/routerpulse.json"
  },
  "dependencies": {
