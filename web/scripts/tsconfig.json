{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2021"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": false,
    "noEmit": false,
    "jsx": "react-jsx"
  },
  "include": ["./**/*.ts", "../src/lib/pdas.ts", "../src/lib/idl/*.json"]
}
