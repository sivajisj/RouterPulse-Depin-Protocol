PORT=3001

MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=routerpulse

REDIS_URL=redis://127.0.0.1:6379

# HS256 signing secret for session JWTs issued after SIWS verification.
# Generate a real random value for anything beyond local dev:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=1h

# Comma-separated origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:3000

# Global rate limit: N requests per TTL_MS per client IP.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
