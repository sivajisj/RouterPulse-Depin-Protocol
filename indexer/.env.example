# RPC endpoint for the cluster to index.
RPC_URL=http://127.0.0.1:8899
# solana-test-validator's websocket is on RPC port + 1, NOT the RPC URL
# with the scheme swapped (which is what happens if you leave this
# unset). Required for a local validator; leave unset for devnet/mainnet
# RPC providers, where http(s) -> ws(s) on the same host is correct.
WS_URL=ws://127.0.0.1:8900

# MongoDB connection string and database name.
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=routerpulse

# Optional. When set, each newly-indexed event is published here so the
# API's WebSocket gateway can fan it out to browsers. Indexing works
# fine without it — a Redis outage costs live updates, never data.
REDIS_URL=redis://127.0.0.1:6379

# Path to the Anchor-generated IDL (built by `anchor build` in ../routerpulse).
IDL_PATH=../routerpulse/target/idl/routerpulse.json

# How often the reconciliation worker re-fetches on-chain accounts and
# compares them against the indexed projection, in milliseconds.
RECONCILE_INTERVAL_MS=30000

# Max signatures to request per getSignaturesForAddress page during backfill.
BACKFILL_PAGE_SIZE=1000
